# SCAD production .env (T3.1). deploy/setup-env.sh fills the generated values;
# you add the three marked YOU. Lives at the repo root as .env, mode 600, and
# is never committed. Back it up (docs/deploy.md, "Backups").

# --- Names --------------------------------------------------------------
# Your DuckDNS name, e.g. myscad.duckdns.org (no https://, no port).
# Sites: https://{slug}.{owner}.BASE_DOMAIN, sign-in: https://auth.BASE_DOMAIN,
# CLI/MCP: https://api.BASE_DOMAIN
BASE_DOMAIN=
# YOU: Let's Encrypt account email (expiry notices only).
ACME_EMAIL=
# YOU: operator email(s). Only these may publish (approve `scad login`).
OPERATOR_EMAILS=

# --- Sign-in email (Gmail) -----------------------------------------------
# YOU: a Gmail app password (Google account > Security > App passwords).
# Format: smtps://<you>%40gmail.com:<app password without spaces>@smtp.gmail.com:465
SMTP_URL=
# Gmail rewrites From to your address anyway.
# SMTP_FROM=SCAD <you@gmail.com>

# --- Generated by deploy/setup-env.sh -------------------------------------
POSTGRES_PASSWORD=
DATABASE_URL=
INTERNAL_SECRET=
INTERNAL_TOKEN=
MASTER_KEY=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- Fixed for this layout ------------------------------------------------
NODE_ENV=production
GATEWAY_FAKE_AUTH=0
# Control plane (host) listens for the gateway and Caddy; deploy/firewall.sh
# allows port 4000 only from the platform network 172.31.250.0/24.
HOST=0.0.0.0
PORT=4000
CONTROL_PLANE_URL=http://host.docker.internal:4000
# Builder talks to the control plane directly, never through Caddy.
SCAD_API_URL=http://127.0.0.1:4000
SCAD_DATA_DIR=/var/lib/scad/data
SCAD_EGRESS_POLICY_DIR=/var/lib/scad/egress-policy
EGRESS_ALLOWED_DOMAINS=*
# gVisor is required on the server (docs/deploy.md step 5; INV6).
SCAD_OCI_RUNTIME=runsc
