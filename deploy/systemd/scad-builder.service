# Builder on the host (T3.1). It scrubs platform secrets from its own
# environment at startup (INV8) and reaches the control plane at SCAD_API_URL
# (127.0.0.1:4000), never through Caddy.
[Unit]
Description=SCAD builder
After=docker.service scad-control-plane.service
Requires=docker.service

[Service]
User=scad
Group=scad
WorkingDirectory=/opt/scad
ExecStart=/usr/bin/bash scripts/with-env.sh pnpm --filter @scad/builder start
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
