{
  "name": "scad",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "dev": "echo \"Use: pnpm --filter @scad/control-plane start & pnpm --filter @scad/builder start & docker compose up -d\"",
    "db:migrate": "pnpm --filter @scad/control-plane db:migrate",
    "test:e2e": "pnpm --filter @scad/e2e test",
    "test:adversarial": "pnpm --filter @scad/adversarial test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:install": "node scripts/build-install-bundle.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.1",
    "esbuild": "0.25.12",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
