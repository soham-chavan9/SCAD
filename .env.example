# Copy to .env and fill in. Required for local development (AGENTS §6).

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgres://scad:scad@localhost:5432/scad

# Hostnames: apps at http://{slug}.{owner}.localhost:8080, auth at http://auth.localhost:8080
BASE_DOMAIN=localhost:8080

# GitHub OAuth app (used by gateway auth host). Optional: leave both empty for
# email sign-in links only. Callback: http://auth.localhost:8080/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LOCAL ONLY. Set to 1 for browserless smoke (FakeIdentityProvider + /login/dev/callback).
# Gateway REFUSES to start if this is 1 and BASE_DOMAIN is not localhost-based.
GATEWAY_FAKE_AUTH=0

# Shared secret for gateway → control-plane /internal/* routes
INTERNAL_SECRET=

# SMTP for magic-link sign-in (T1.1) and the control plane's expiry warnings (T2.5) —
# Mailpit locally (UI at http://localhost:8025). Unset on the control plane = log only.
# The Compose gateway uses smtp://mailpit:1025 (override with GATEWAY_SMTP_URL).
SMTP_URL=smtp://localhost:1025
# Optional From header. Default: SCAD <no-reply@auth.{BASE_DOMAIN host}>
# SMTP_FROM=
# GATEWAY_SMTP_URL=smtp://mailpit:1025

# 32-byte key, base64-encoded (generate: openssl rand -base64 32). Encrypts app
# env vars and secrets (T1.6). Unset = `scad env` disabled. Back it up.
MASTER_KEY=
# Only while rotating MASTER_KEY: the old key(s), comma-separated. See docs/secrets.md.
# MASTER_KEY_PREVIOUS=

# Ed25519 PEM pair for identity JWTs (gateway). If unset, gateway generates ephemeral keys.
# openssl genpkey -algorithm Ed25519 -out jwt-private.pem
# openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Only while rotating the JWT key: the old public key(s), still served in the JWKS. See docs/identity.md.
# JWT_PREVIOUS_PUBLIC_KEY=

# Control plane URL as seen from the gateway container
CONTROL_PLANE_URL=http://host.docker.internal:4000

# Comma-separated operator emails (T2.6). They may approve `scad login`
# (device flow), use `scad admin ...`, and always create an account. Everyone
# else needs an invite (`scad admin invite add`) or an app shared to them.
# Read by the control plane and the gateway.
OPERATOR_EMAILS=

# Control plane (T0.5). Where the CLI/MCP reach it; shown in `scad login`.
# Unset: http://127.0.0.1:4000 on localhost, https://api.{BASE_DOMAIN} on a real domain (T3.1).
PUBLIC_BASE_URL=http://127.0.0.1:4000
SCAD_DATA_DIR=./.scad-data
# Shared secret for the builder. Generate: openssl rand -hex 24
INTERNAL_TOKEN=

# CLI
SCAD_API_URL=http://127.0.0.1:4000
# Optional local auto-approve for `scad login --approve-email`
# SCAD_APPROVE_EMAIL=you@example.com

# Production (T3.1, deploy/): NODE_ENV=production makes the gateway refuse
# GATEWAY_FAKE_AUTH. GATEWAY_TRUST_PROXY = IPs/CIDRs of the TLS front whose
# X-Forwarded-For the gateway trusts (deploy/compose.yml pins Caddy's).
# Production uses deploy/env.production.example instead of this file.
# NODE_ENV=production
# GATEWAY_TRUST_PROXY=

# Optional overrides (defaults shown)
# PORT=4000
# HOST=0.0.0.0
# BUILDER_POLL_MS=500
# SCAD_CONFIG=
# SCAD_ALLOW_DB_TRUNCATE=0
# SCAD_HOST_GATEWAY_IP=

# Egress (T2.1). Apps reach the internet only via the egress proxy, and only to
# public domains listed in their scad.json "egress". `*` (the default; unset or
# empty means the same) allows any declared domain. A comma list (`*.example.com`
# patterns) narrows what apps may declare. `none` refuses all egress.
# Private, loopback, link-local, metadata, and reserved addresses are always refused.
EGRESS_ALLOWED_DOMAINS=*
# Where the runtime driver writes per-app egress policy (mounted read-only by the proxy).
# SCAD_EGRESS_POLICY_DIR=~/.scad/egress-policy

# Container runtime (T2.2, INV6). auto = gVisor `runsc` when Docker has it, else
# Docker's default (runc); runsc = require gVisor (refuse to run apps without it);
# runc = never use gVisor. See docs/hardening.md.
# SCAD_OCI_RUNTIME=auto

# Runtime driver the control plane uses (D4). Only `docker` exists until M3.
# SCAD_RUNTIME=docker
